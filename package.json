{
	"name": "@iamprompt/n8n-nodes-arcane",
	"version": "0.1.4",
	"description": "n8n community node for managing Docker containers, compose stacks, and environments via Arcane REST API",
	"license": "MIT",
	"homepage": "https://github.com/iamprompt/n8n-nodes-arcane",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"n8n-community-node-package",
		"arcane",
		"docker",
		"containers",
		"docker-compose"
	],
	"author": {
		"name": "iamprompt",
		"email": "opensource@iamprompt.me"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/iamprompt/n8n-nodes-arcane.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "node --test test/functional.test.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ArcaneApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Arcane/Arcane.node.js",
			"dist/nodes/ArcaneTrigger/ArcaneTrigger.node.js",
			"dist/nodes/ArcaneWebhookTrigger/ArcaneWebhookTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "^9.39.4",
		"prettier": "^3.9.10",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
